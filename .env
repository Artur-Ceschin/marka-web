# Non-secret defaults, committed. Override locally in .env.local (gitignored).
# A Cognito app-client id is a public identifier, not a secret: it ships in the
# redirect URL of every OAuth flow. There is no client secret in a PKCE flow.

VITE_API_URL=https://api.markaplant.app

# Fill these in to enable Google sign-in. Email and password work without them.
VITE_COGNITO_DOMAIN=marka-auth-dev.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=6bqdfo05liqntb6kmgmvqnbqbn

# Must match a callback registered on the Cognito app client, exactly.
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
