# ─── REST API ────────────────────────────────────────────────────────────────
# Backend base URL. Used by src/lib/api.ts on every request.
# In dev: http://localhost:3001
# In prod: the deployed API Gateway URL (NO trailing slash)
NEXT_PUBLIC_REST_API_URL=

# Public origin of the web app (used in OAuth callbacks)
NEXT_PUBLIC_APP_URL=

# ─── Cognito ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=

# ─── CDNs ────────────────────────────────────────────────────────────────────
# CloudFront origin for static marketing assets (videos, brand imagery)
NEXT_PUBLIC_ASSETS_URL=

# CloudFront origin that fronts the user-images S3 bucket.
# src/lib/cdn.ts rewrites S3 URLs returned by the API to this CDN host.
NEXT_PUBLIC_IMAGES_CDN_URL=

# Optional: the S3 origin that NEXT_PUBLIC_IMAGES_CDN_URL fronts.
# If unset, cdn.ts falls back to the dev bucket — set this explicitly in prod.
NEXT_PUBLIC_IMAGES_S3_ORIGIN=

# ─── Third-party ─────────────────────────────────────────────────────────────
# Nominatim (OpenStreetMap) usage policy requires a contact email in requests.
# Used by src/app/(app)/explore/page.tsx reverse + forward geocoding.
NEXT_PUBLIC_NOMINATIM_EMAIL=contact@marka.app
